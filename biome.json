{
	"$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
	"files": {
		"includes": ["**", "!**/dist", "!**/docs", "!**/src/**/*.po.ts"]
	},
	"formatter": {
		"bracketSpacing": false,
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "asNeeded",
			"quoteStyle": "single",
			"trailingCommas": "es5"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"style": {
				"noParameterAssign": "off",
				"noUnusedTemplateLiteral": "off",
				"noUselessElse": "off",
				"useImportType": "off",
				"useNumberNamespace": "off",
				"useTemplate": "off"
			},
			"complexity": {
				"noStaticOnlyClass": "off",
				"noThisInStatic": "off",
				"useArrowFunction": "off",
				"noArguments": "off"
			},
			"performance": {
				"noDelete": "off"
			},
			"suspicious": {
				"noDoubleEquals": "off",
				"noGlobalIsNan": "off",
				"noImplicitAnyLet": "off",
				"noPrototypeBuiltins": "off"
			}
		}
	}
}

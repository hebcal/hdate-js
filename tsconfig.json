{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rootDir": "src",
    "outDir": "dist/esm",
    "sourceMap": true
  },
  "include": ["src"]
}

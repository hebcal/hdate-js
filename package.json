{
  "name": "@hebcal/hdate",
  "version": "0.22.5",
  "description": "converts between Hebrew and Gregorian dates using Rata Die (R.D.) algorithm by Dershowitz and Reingold",
  "author": "Michael J. Radwin (https://github.com/mjradwin)",
  "contributors": [
    "Eyal Schachter (https://github.com/Scimonster)",
    "Danny Sadinoff (https://github.com/dsadinoff)"
  ],
  "license": "GPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hebcal/hdate-js.git"
  },
  "type": "module",
  "module": "dist/esm/index.js",
  "typings": "dist/esm/index.d.ts",
  "exports": {
    ".": "./dist/esm/index.js",
    "./dist/esm/*": "./dist/esm/*.js"
  },
  "keywords": [
    "hebcal",
    "hebrew",
    "calendar",
    "date"
  ],
  "files": [
    "dist/esm",
    "po"
  ],
  "scripts": {
    "build:tsc": "tsc",
    "build:banner": "node ./add-banner.mjs",
    "build": "npm run po2json && npm run build:tsc && npm run build:banner",
    "prepublish": "npm run build",
    "po2json": "node ./po2json.js po/he.po po/ashkenazi.po",
    "docs": "typedoc",
    "pretest": "npm run build",
    "lint": "biome lint .",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "clean": "node -e \"for (const dir of ['dist', 'coverage']) require('node:fs').rmSync(dir, {recursive: true, force: true})\"",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "gettext-parser": "^9.1.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
